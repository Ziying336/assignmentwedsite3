  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "游戏创作者 X 设计师 ｜ Chee Ying",
        "meta_descr": "\"演进\"概括了设计与游戏领域在技术驱动下，从起源、近代到现代的持续变迁；而\"回响\"则暗示了在这场变革中，那些始终留存的人文价值、手作的温度以及对本真体验的呼唤，它们如同悠长的回响，在效率至上的时代里依然清晰可辨。",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/2025-10-15-11.58.25-1.png"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
